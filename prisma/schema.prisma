generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  OVERDUE
  CANCELED
}

enum BookingStatus {
  RESERVED
  CANCELED
  PRESENT
  ABSENT
}

enum MakeupCreditStatus {
  AVAILABLE
  USED
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

enum ManualPaymentMethod {
  PIX
  CASH
  CARD_IN_PERSON
}

model User {
  id           String   @id @default(cuid())
  fullName     String?
  email        String   @unique
  passwordHash String
  role         Role
  student      Student?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id          String               @id @default(cuid())
  userId      String?              @unique
  fullName    String
  phone       String
  birthDate   DateTime
  user        User?                @relation(fields: [userId], references: [id])
  health      HealthProfile?
  healthHistory HealthProfileHistory[]
  progress    FunctionalProgress[]
  enrollments Enrollment[]
  bookings    Booking[]
  messages    StudentMessage[]
  makeupCredits MakeupCredit[]
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model StudentMessage {
  id        String   @id @default(cuid())
  studentId String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
}

model Plan {
  id                 String       @id @default(cuid())
  name               String
  monthlyPriceCents  Int
  weeklyBookingLimit Int          @default(2)
  enrollments        Enrollment[]
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  planId    String
  status    EnrollmentStatus @default(PENDING)
  startsAt  DateTime
  student   Student          @relation(fields: [studentId], references: [id])
  plan      Plan             @relation(fields: [planId], references: [id])
  classSlotId String?
  classSlot ClassSlot? @relation(fields: [classSlotId], references: [id])
  invoices  Invoice[]
  manualPayments ManualPayment[]
}

model Invoice {
  id           String        @id @default(cuid())
  enrollmentId String
  amountCents  Int
  dueDate      DateTime
  referenceMonth DateTime
  status       InvoiceStatus @default(PENDING)
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  paymentLinks ManualPaymentInvoice[]
  createdAt    DateTime      @default(now())
  @@unique([enrollmentId, referenceMonth])
}

model ManualPayment {
  id            String              @id @default(cuid())
  enrollmentId  String
  method        ManualPaymentMethod
  amountCents   Int
  monthsCovered Int
  receivedAt    DateTime
  notes         String?
  receivedBy    String
  invoices      ManualPaymentInvoice[]
  createdAt     DateTime            @default(now())
  enrollment    Enrollment          @relation(fields: [enrollmentId], references: [id])
}

model ManualPaymentInvoice {
  paymentId String
  invoiceId String
  payment   ManualPayment @relation(fields: [paymentId], references: [id])
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  @@id([paymentId, invoiceId])
}

model ClassSlot {
  id         String            @id @default(cuid())
  weekday    Int
  secondWeekday Int?
  startsTime String
  duration   Int
  capacity   Int
  occurrences ClassOccurrence[]
  enrollments Enrollment[]
}

model ClassOccurrence {
  id          String      @id @default(cuid())
  classSlotId String
  startsAt    DateTime
  endsAt      DateTime
  classSlot   ClassSlot   @relation(fields: [classSlotId], references: [id])
  bookings    Booking[]
  @@unique([classSlotId, startsAt])
}

model Booking {
  id           String          @id @default(cuid())
  studentId    String
  occurrenceId String
  status       BookingStatus   @default(RESERVED)
  student      Student         @relation(fields: [studentId], references: [id])
  occurrence   ClassOccurrence @relation(fields: [occurrenceId], references: [id])
  createdAt    DateTime        @default(now())
  sourceMakeupCredit MakeupCredit? @relation("MakeupSourceBooking")
  usedMakeupCredit MakeupCredit? @relation("MakeupUsedBooking")
  @@unique([studentId, occurrenceId])
}

model MakeupCredit {
  id              String             @id @default(cuid())
  studentId       String
  sourceBookingId String             @unique
  usedBookingId   String?            @unique
  status          MakeupCreditStatus @default(AVAILABLE)
  createdAt       DateTime           @default(now())
  usedAt          DateTime?
  student         Student            @relation(fields: [studentId], references: [id])
  sourceBooking   Booking            @relation("MakeupSourceBooking", fields: [sourceBookingId], references: [id])
  usedBooking     Booking?           @relation("MakeupUsedBooking", fields: [usedBookingId], references: [id])
}

model HealthProfile {
  id           String   @id @default(cuid())
  studentId    String   @unique
  consentedAt  DateTime
  restrictions String
  goals        String?
  observations String?
  student      Student  @relation(fields: [studentId], references: [id])
  updatedAt    DateTime @updatedAt
}

model HealthProfileHistory {
  id           String   @id @default(cuid())
  studentId    String
  actorId      String
  consentedAt  DateTime
  restrictions String
  goals        String?
  observations String?
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id])
}

model FunctionalProgress {
  id        String   @id @default(cuid())
  studentId String
  note      String
  createdBy String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  reason    String?
  createdAt DateTime @default(now())
}
